# csgdaa-code workspace config
# This file specifies which files Git should ignore in this directory

# Session data (may contain sensitive conversation history)
sessions/

# Permissions (user/machine specific)
permissions.json

# Auto-generated skill manifests (regenerated by csgdaa-code at runtime)
skills.json
skills.lock

# Debug logs
debug.log
*.log

# Temporary files
*.tmp
*.temp

# Editor files
.DS_Store
*.swp
*~
